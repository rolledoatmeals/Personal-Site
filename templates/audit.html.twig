{% extends 'base.html.twig' %}

{% block title %}Free Website Audit | {{ site.title }}{% endblock %}

{% block content %}
{% include 'partials/nav.html.twig' %}

  <main>
    <section id="audit" class="audit section--dark">
      <div class="container audit-inner">
        <p class="hero-eyebrow">Live tool &middot; built by {{ person.name }}</p>
        <h1 class="audit-title">Is your website costing you customers?</h1>
        <p class="audit-sub">Paste an address. In about ten seconds you get the same checks I run by hand before quoting any client: speed, mobile usability, and whether search engines can actually read the page.</p>

        <form id="audit-form" class="audit-form" autocomplete="off">
          <input id="audit-url" type="text" inputmode="url" placeholder="yourbusiness.com" aria-label="Website address" required>
          <button type="submit" class="btn btn-primary" id="audit-go">Run the audit</button>
        </form>
        <p class="audit-type-row">
          <label for="audit-type">Site type</label>
          <select id="audit-type" aria-label="What kind of site is this">
            <option value="">Work it out for me</option>
            <option value="local">Local business</option>
            <option value="ecommerce">Online store</option>
            <option value="portfolio">Portfolio or personal</option>
            <option value="saas">Software or app</option>
          </select>
          <span class="audit-type-note">Changes what counts. A missing phone number matters for a shop, not for a portfolio.</span>
        </p>

        <div id="audit-status" class="audit-status" role="status" aria-live="polite"></div>

        <div id="audit-result" class="audit-result" hidden>
          <div class="audit-head">
            <div class="audit-score-wrap">
              <svg class="audit-ring" viewBox="0 0 120 120" aria-hidden="true">
                <circle cx="60" cy="60" r="52" class="audit-ring-bg"/>
                <circle cx="60" cy="60" r="52" class="audit-ring-fg" id="audit-ring-fg"/>
              </svg>
              <div class="audit-score" id="audit-score">0</div>
            </div>
            <div class="audit-meta">
              <p class="audit-headline" id="audit-headline"></p>
              <p id="audit-checked" class="audit-checked"></p>
              <p id="audit-chips" class="audit-chips"></p>
            </div>
          </div>
          <div id="audit-cats" class="audit-cats"></div>
          <div class="audit-cta">
            <p>Keep this report, or send it to whoever owns the site.</p>
            <div class="audit-cta-actions">
              <a class="btn btn-primary" id="audit-download" target="_blank" rel="noopener" href="#">Save as PDF</a>
              <button type="button" class="btn btn-ghost" id="audit-copy">Copy as text</button>
              <button type="button" class="btn btn-ghost" id="audit-share">Copy link</button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

{% include 'partials/footer.html.twig' %}

<style nonce="{{ nonce }}" id="audit-dyn"></style>
<script nonce="{{ nonce }}">
(function () {
	var dyn = document.getElementById('audit-dyn');
	function setRules(css) { dyn.textContent = css; }

	var form = document.getElementById('audit-form');
	var input = document.getElementById('audit-url');
	var status = document.getElementById('audit-status');
	var result = document.getElementById('audit-result');
	var btn = document.getElementById('audit-go');

	var typeSel = document.getElementById('audit-type');

	function run(url, type) {
		if (!url) return;
		btn.disabled = true;
		result.hidden = true;
		status.textContent = 'Fetching the page the way a phone would...';

		fetch('/api/audit?url=' + encodeURIComponent(url) + (type ? '&type=' + encodeURIComponent(type) : ''))
			.then(function (r) { return r.json(); })
			.then(function (data) {
				btn.disabled = false;
				if (data.error) { status.textContent = data.error; return; }
				status.textContent = '';
				render(data);
			})
			.catch(function () {
				btn.disabled = false;
				status.textContent = 'Something went wrong on my end. Try once more.';
			});
	}

	form.addEventListener('submit', function (e) {
		e.preventDefault();
		var url = input.value.trim();
		if (!url) return;
		var type = typeSel.value;
		var share = location.pathname + '?url=' + encodeURIComponent(url) + (type ? '&type=' + encodeURIComponent(type) : '');
		history.replaceState(null, '', share);
		run(url, type);
	});

	// A link like /audit?url=example.com opens with that audit already running,
	// so a report can be handed to someone as a single link.
	var params = new URLSearchParams(location.search);
	var preset = params.get('url');
	if (preset) {
		input.value = preset;
		var presetType = params.get('type') || '';
		if (presetType) typeSel.value = presetType;
		run(preset, presetType);
	}

	function render(data) {
		var score = data.score;
		var scoreEl = document.getElementById('audit-score');
		var ring = document.getElementById('audit-ring-fg');
		var C = 2 * Math.PI * 52;
		var band = score >= 85 ? 'is-good' : score >= 60 ? 'is-warn' : 'is-bad';
		ring.setAttribute('class', 'audit-ring-fg ' + band);
		var rules = ['.audit-ring-fg{stroke-dasharray:' + C + ';stroke-dashoffset:' + C + '}'];

		document.getElementById('audit-headline').textContent = data.headline;
		document.getElementById('audit-checked').textContent = data.url;

		var chips = document.getElementById('audit-chips');
		chips.innerHTML = '';

		var typeChip = document.createElement('span');
		typeChip.className = 'audit-chip is-type';
		var det = data.detected || {};
		if (det.auto === false) {
			typeChip.textContent = 'You picked: ' + data.site_type_label;
		} else if (det.why && det.why.length) {
			typeChip.textContent = 'Looks like a ' + data.site_type_label.toLowerCase() + ' — ' + det.why[0];
		} else {
			typeChip.textContent = 'Scored as a ' + data.site_type_label.toLowerCase();
		}
		typeChip.title = det.auto === false
			? 'You chose this. Change it above to rescore.'
			: 'Worked out automatically. Pick a type above if this is wrong.';
		chips.appendChild(typeChip);

		if (typeSel.value === '') typeSel.value = data.site_type;

		[
			data.platform,
			data.page_kb + ' KB',
			data.seconds + 's',
			data.https ? 'HTTPS' : 'No HTTPS',
			data.analytics ? 'Tracking on' : 'No tracking',
			data.js_rendered ? 'JavaScript-rendered' : null
		].filter(Boolean).forEach(function (t) {
			var c = document.createElement('span');
			c.className = 'audit-chip';
			c.textContent = t;
			chips.appendChild(c);
		});

		var wrap = document.getElementById('audit-cats');
		wrap.innerHTML = '';
		var delay = 0;
		data.categories.forEach(function (cat) {
			var sec = document.createElement('section');
			sec.className = 'audit-cat';

			var head = document.createElement('div');
			head.className = 'audit-cat-head';
			var h = document.createElement('h2');
			h.textContent = cat.label;
			var pct = document.createElement('span');
			pct.className = 'audit-cat-pct ' + (cat.pct >= 85 ? 'is-good' : cat.pct >= 60 ? 'is-warn' : 'is-bad');
			pct.textContent = cat.pct + '%';
			head.appendChild(h);
			head.appendChild(pct);

			var bar = document.createElement('div');
			bar.className = 'audit-bar';
			var fill = document.createElement('i');
			fill.className = 'audit-bar-fill ' + (cat.pct >= 85 ? 'is-good' : cat.pct >= 60 ? 'is-warn' : 'is-bad');
			fill.setAttribute('data-cat', cat.key);
			bar.appendChild(fill);

			var list = document.createElement('ul');
			list.className = 'audit-findings';
			cat.findings.forEach(function (f) {
				var li = document.createElement('li');
				li.className = 'audit-finding is-' + f.level;
				li.setAttribute('data-d', String(delay += 55));
				var t = document.createElement('strong');
				t.textContent = f.title;
				var d = document.createElement('p');
				d.textContent = f.detail;
				li.appendChild(t);
				li.appendChild(d);
				list.appendChild(li);
			});

			sec.appendChild(head);
			sec.appendChild(bar);
			sec.appendChild(list);
			wrap.appendChild(sec);
		});

		data.categories.forEach(function (c) {
			rules.push('.audit-bar-fill[data-cat="' + c.key + '"]{width:' + c.pct + '%}');
		});
		for (var d = 55; d <= delay; d += 55) {
			rules.push('.audit-finding[data-d="' + d + '"]{transition-delay:' + d + 'ms}');
		}
		setRules(rules.join(''));

		lastReport = data;
		document.getElementById('audit-download').href =
			'/audit/report?print=1&url=' + encodeURIComponent(data.url);

		result.hidden = false;
		requestAnimationFrame(function () {
			requestAnimationFrame(function () {
				setRules(rules.join('') + '.audit-ring-fg{stroke-dasharray:' + C + ';stroke-dashoffset:' + (C * (1 - score / 100)) + '}');
				var n = 0;
				var step = Math.max(1, Math.round(score / 40));
				var timer = setInterval(function () {
					n = Math.min(score, n + step);
					scoreEl.textContent = n;
					if (n >= score) clearInterval(timer);
				}, 24);
				wrap.querySelectorAll('.audit-findings').forEach(function (l) { l.classList.add('in'); });
			});
		});
	}

	var lastReport = null;

	function reportText(d) {
		var L = [];
		L.push('WEBSITE AUDIT');
		L.push(d.url);
		L.push(new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }));
		L.push('');
		L.push('SCORE: ' + d.score + ' / 100');
		L.push(d.headline);
		L.push('');
		L.push('Platform: ' + d.platform);
		L.push('Page weight: ' + d.page_kb + ' KB (' + d.html_kb + ' KB of that is HTML)');
		L.push('Server response: ' + d.seconds + 's');
		L.push('Secure (HTTPS): ' + (d.https ? 'yes' : 'no'));
		L.push('Analytics installed: ' + (d.analytics ? 'yes' : 'no'));
		if (d.js_rendered) L.push('Note: this page renders with JavaScript, so some checks are limited.');
		L.push('');
		d.categories.forEach(function (c) {
			L.push('--------------------------------------------');
			L.push(c.label.toUpperCase() + ' - ' + c.pct + '%');
			L.push('');
			c.findings.forEach(function (f) {
				var mark = f.level === 'bad' ? '[!]' : f.level === 'warn' ? '[~]' : '[ok]';
				L.push(mark + ' ' + f.title);
				L.push('    ' + f.detail);
				L.push('');
			});
		});
		L.push('--------------------------------------------');
		L.push('Audited with the free tool at zacharyshep.com/audit');
		L.push('Questions, or want these fixed: {{ contact.email }}');
		return L.join('\n');
	}

	function slug(u) {
		return u.replace(/^https?:\/\//, '').replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '').slice(0, 50);
	}

	document.getElementById('audit-copy').addEventListener('click', function () {
		if (!lastReport) return;
		var btn = this;
		var text = reportText(lastReport);
		var done = function () {
			var was = btn.textContent;
			btn.textContent = 'Copied';
			setTimeout(function () { btn.textContent = was; }, 1600);
		};
		if (navigator.clipboard && window.isSecureContext) {
			navigator.clipboard.writeText(text).then(done, function () { fallback(text, done); });
		} else {
			fallback(text, done);
		}
	});

	function fallback(text, done) {
		var ta = document.createElement('textarea');
		ta.value = text;
		ta.className = 'audit-offscreen';
		document.body.appendChild(ta);
		ta.select();
		try { document.execCommand('copy'); done(); } catch (e) {}
		document.body.removeChild(ta);
	}

	document.getElementById('audit-share').addEventListener('click', function () {
		if (!lastReport) return;
		var btn = this;
		var link = location.origin + location.pathname + '?url=' + encodeURIComponent(lastReport.url);
		var done = function () {
			var was = btn.textContent;
			btn.textContent = 'Link copied';
			setTimeout(function () { btn.textContent = was; }, 1600);
		};
		if (navigator.clipboard && window.isSecureContext) {
			navigator.clipboard.writeText(link).then(done, function () { fallback(link, done); });
		} else {
			fallback(link, done);
		}
	});

})();
</script>
{% endblock %}
