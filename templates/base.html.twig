<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% block title %}{{ site.title|default('Zachary Shepelsky') }}{% endblock %}</title>
  <meta name="description" content="{{ seo.description|default(site.tagline|default('AI Automation & Web Developer')) }}">
  <meta name="keywords" content="{{ seo.keywords|default('Zachary Shepelsky, AI automation, web developer') }}">
  <meta name="author" content="{{ site.title|default('Zachary Shepelsky') }}">
  <meta name="robots" content="{{ seo.robots|default('index,follow') }}">
  <meta name="theme-color" content="#0a0f1e">

  <link rel="canonical" href="{{ seo.canonical_url|default('https://zacharyshep.com/') }}">
  <link rel="sitemap" type="application/xml" href="/sitemap.xml">

  <meta property="og:image" content="{{ seo.canonical_url|default('https://zacharyshep.com/') }}assets/images/profile.jpg">
  <meta property="og:image:width" content="800">
  <meta property="og:image:height" content="800">
  <meta property="og:image:alt" content="{{ site.title|default('Zachary Shepelsky') }} — AI Automation &amp; Web Developer">
  <meta name="twitter:image" content="{{ seo.canonical_url|default('https://zacharyshep.com/') }}assets/images/profile.jpg">
  <meta name="twitter:image:alt" content="{{ site.title|default('Zachary Shepelsky') }} — AI Automation &amp; Web Developer">

  <meta property="og:locale" content="{{ seo.locale|default('en_US') }}">
  <meta property="og:type" content="{{ seo.og_type|default('website') }}">
  <meta property="og:site_name" content="{{ site.title|default('Zachary Shepelsky') }}">
  <meta property="og:title" content="{{ seo.title|default(site.title|default('Zachary Shepelsky')) }}">
  <meta property="og:description" content="{{ seo.description|default(site.tagline|default('AI Automation & Web Developer')) }}">
  <meta property="og:url" content="{{ seo.canonical_url|default('https://zacharyshep.com/') }}">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo.title|default(site.title|default('Zachary Shepelsky')) }}">
  <meta name="twitter:description" content="{{ seo.description|default(site.tagline|default('AI Automation & Web Developer')) }}">

  <link rel="preload" href="/assets/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/syne-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css?v=4">

  <!-- simple SVG favicon -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%230a0f1e'/%3E%3Ctext x='50' y='57' font-size='48' fill='%23fff' text-anchor='middle' font-family='Syne, Arial, sans-serif'%3EZS%3C/text%3E%3C/svg%3E">
{% if seo.json_ld is defined %}
  <script type="application/ld+json" nonce="{{ nonce }}">{{ seo.json_ld|raw }}</script>
{% endif %}
</head>
<body>
  <div class="site-loader" aria-hidden="true"><div class="loader-dot"></div></div>
  <div id="page">
{% block content %}{% endblock %}
  </div>

  <script src="/assets/js/main.js?v=3" defer nonce="{{ nonce }}"></script>
</body>
</html>

