{% extends 'base.html.twig' %}

{% block title %}{{ site.title }} | {{ site.tagline }}{% endblock %}

{% block content %}
  {% include 'partials/nav.html.twig' %}

  <main>
    <section id="hero" class="hero">
      <div class="container">
        <h1>{{ person.name }}</h1>
        <p class="tagline">{{ site.tagline }}</p>
        <a class="scroll-down" href="#about" aria-label="Scroll to about">Learn more ↓</a>
      </div>
    </section>

    <section id="about" class="about">
      <div class="container">
        <h2>About</h2>
        <p>{{ person.bio }}</p>
        <h3>Hobbies</h3>
        <ul class="hobbies">
          {% for hobby in person.hobbies %}
            <li>{{ hobby }}</li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <section id="skills" class="skills">
      <div class="container">
        <h2>What I work with</h2>
        <div class="tags">
          {% set skills = person.works_with is defined ? person.works_with : (works_with is defined ? works_with : []) %}
          {% if skills|length > 0 %}
            {% for s in skills %}<span class="tag">{{ s }}</span>{% endfor %}
          {% else %}
            <p class="muted">PHP · JavaScript · AI · APIs</p>
          {% endif %}
        </div>
      </div>
    </section>

    <section id="contact" class="contact">
      <div class="container">
        <h2>Contact</h2>
        <p><a href="mailto:{{ contact.email }}">{{ contact.email }}</a> · <a href="{{ contact.linkedin }}" target="_blank" rel="noopener">LinkedIn</a></p>
      </div>
    </section>
  </main>

  {% include 'partials/footer.html.twig' %}
{% endblock %}
