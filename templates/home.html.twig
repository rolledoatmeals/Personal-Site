{% extends 'base.html.twig' %}

{% block title %}{{ site.title }} | {{ site.tagline }}{% endblock %}

{% block content %}
  {% include 'partials/nav.html.twig' %}

  <main>
    <section id="hero" class="hero section--dark">
      <div class="container hero-inner">
        <div class="hero-left">
          <h1 class="hero-title">{{ person.name }}</h1>
          <p class="hero-sub">I'm a motivated software developer with extensive experience across multiple programming languages and web technologies. I enjoy tackling practical problems, shipping durable solutions, and learning new tools that make projects better.</p>
          <p class="hero-sub muted">I thrive in fast‑paced environments, enjoy collaborating with teams, and like turning ideas into polished, useful products — scroll down to learn more.</p>
          <p class="hero-links">
            <a class="social-link" href="{{ contact.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.1 1 2.48 1 4.98 2.12 4.98 3.5zM.22 8H4.78V24H.22zM8.98 8h4.34v2.18h.06c.6-1.14 2.06-2.34 4.24-2.34 4.54 0 5.38 2.98 5.38 6.86V24h-4.56v-7.06c0-1.68-.03-3.83-2.33-3.83-2.33 0-2.68 1.82-2.68 3.69V24H8.98z" fill="currentColor"/></svg>
            </a>
          </p>
        </div>
        <a class="scroll-down" href="#about" aria-label="Scroll to about">
          <span class="arrow">↓</span>
        </a>
      </div>
    </section>

    <section id="about" class="about section--alt">
      <div class="container">
        <h2 class="about-heading">About Me</h2>

        <div class="about-rows">
          <div class="about-row">
            <img class="about-img" src="/assets/images/profile.jpg" loading="lazy" alt="{{ person.name }}" width="200" height="200">
            <div class="about-text">
              <p class="about-bio">Skilled and motivated software developer with several years of experience building web applications and APIs. I’ve worked with PHP, JavaScript, MySQL, and modern frameworks to deliver maintainable, well-tested features that serve users.</p>
              <p class="about-bio">I currently reside in Charlotte, North Carolina. When I'm not building software I enjoy mountain biking, motorcycling, and snowboarding. I also have a German Shepherd who keeps me grounded and outdoors.</p>
            </div>
          </div>

          <div class="about-row">
            <img class="about-img" src="/assets/images/snowboard.jpg" loading="lazy" alt="Outdoor activity" width="200" height="200">
            <div class="about-text">
              <p class="about-hobbies">Hobbies: {% for h in person.hobbies %}{{ h }}{% if not loop.last %}, {% endif %}{% endfor %}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="skills" class="skills section--skills">
      <div class="container">
        <h2>Skills</h2>
        <div class="skills-grid">
          {% set skills_list = ['PHP','HTML','CSS','JavaScript','AI Automation','GoHighLevel','CRM','Vibe Coding'] %}
          {% import 'partials/icons.html.twig' as icons %}
          {% for s in skills_list %}
            <div class="skill-card" data-i="{{ loop.index0 }}">
              <div class="skill-emoji">{{ icons.skill_icon(s) }}</div>
              <div class="skill-name">{{ s }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section id="contact" class="contact section--contact">
      <div class="container contact-inner">
        <h2>Contact Details</h2>
        <div class="contact-grid">
          <div>
            <p>{{ person.name }}</p>
            <p>{{ person.location }}</p>
            <p><a href="mailto:{{ contact.email }}">{{ contact.email }}</a></p>
          </div>
          <div>
            <p>Find me on <a href="{{ contact.linkedin }}" target="_blank" rel="noopener">LinkedIn</a></p>
            <p class="muted">Or use the email link to start a conversation about projects or collaborations.</p>
          </div>
        </div>
        <a class="back-to-top" href="#hero" aria-label="Back to top">↑</a>
      </div>
    </section>
  </main>

  {% include 'partials/footer.html.twig' %}
{% endblock %}
