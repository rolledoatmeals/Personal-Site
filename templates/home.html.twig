{% extends 'base.html.twig' %}

{% block title %}{{ site.title }} | {{ site.tagline }}{% endblock %}

{% block content %}
{% include 'partials/nav.html.twig' %}

  <main>
    <section id="hero" class="hero section--dark">
      <div class="container hero-inner">
        <div class="hero-left">
          <h1 class="hero-title">{{ person.name }}</h1>
          <p class="hero-sub">{{ site.tagline }}</p>
          <p class="hero-descriptor">{{ hero.descriptor }}</p>
          <p class="hero-links">
            <a class="social-link" href="{{ contact.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.88 6 2.5 6S0 4.88 0 3.5 1.1 1 2.48 1 4.98 2.12 4.98 3.5zM.22 8H4.78V24H.22zM8.98 8h4.34v2.18h.06c.6-1.14 2.06-2.34 4.24-2.34 4.54 0 5.38 2.98 5.38 6.86V24h-4.56v-7.06c0-1.68-.03-3.83-2.33-3.83-2.33 0-2.68 1.82-2.68 3.69V24H8.98z" fill="currentColor"/></svg>
            </a>
          </p>
        </div>

      </div>
    </section>

    <section id="about" class="about section--alt">
      <div class="container">
        <h2 class="about-heading">About</h2>

        <div class="about-rows">
          <div class="about-row">
            <picture>
              <source srcset="/assets/images/profile-480.webp 480w, /assets/images/profile-960.webp 960w" type="image/webp">
              <img class="about-img" srcset="/assets/images/profile-480.jpg 480w, /assets/images/profile-960.jpg 960w" sizes="210px" src="/assets/images/profile-480.jpg" loading="lazy" alt="Zachary Shepelsky" width="210" height="210">
            </picture>
            <div class="about-text">
              <p class="about-bio">{{ person.bio|nl2br|raw }}</p>
            </div>
          </div>

          <div class="about-row">
            <picture>
              <source srcset="/assets/images/snowboard-480.webp 480w, /assets/images/snowboard-960.webp 960w" type="image/webp">
              <img class="about-img" srcset="/assets/images/snowboard-480.jpg 480w, /assets/images/snowboard-960.jpg 960w" sizes="210px" src="/assets/images/snowboard-480.jpg" loading="lazy" alt="Zachary Shepelsky snowboarding" width="210" height="210">
            </picture>
            <div class="about-text">
              <p class="about-bio">{{ person.bio2 }}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="skills" class="skills section--skills">
      <div class="container">
        <h2>Skills</h2>
        <div class="skills-grid">
{% import 'partials/icons.html.twig' as icons %}
{% for s in skills %}
            <div class="skill-card" data-i="{{ loop.index0 }}">
              <div class="skill-emoji">{{ icons.skill_icon(s.name) }}</div>
              <div class="skill-name">{{ s.name }}</div>
              <div class="skill-desc">{{ s.desc }}</div>
            </div>
{% endfor %}
        </div>
      </div>
    </section>

    <section id="contact" class="contact section--contact">
      <div class="container contact-inner">
        <h2>Get in touch</h2>
        <p class="contact-sub">{{ contact.blurb }}</p>
        <div class="contact-actions">
          <a class="btn btn-primary btn-ghost" href="{{ contact.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn btn-primary" href="mailto:{{ contact.email }}">{{ contact.email }}</a>
        </div>
        <a class="back-to-top" href="#hero" aria-label="Back to top">↑</a>
      </div>
    </section>
  </main>

{% include 'partials/footer.html.twig' %}
{% endblock %}
