<header class="site-nav" role="banner">
  <div class="nav-inner">
    <a class="logo" href="/" aria-label="Home">
      <span class="logo-mark">ZS</span>
    </a>

    <nav class="nav-links" role="navigation" aria-label="Primary">
      <ul>
        {% for item in nav %}
          <li><a href="{{ item.href }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <button class="hamburger" aria-controls="mobile-menu" aria-expanded="false" aria-label="Toggle menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <ul>
      {% for item in nav %}
        <li><a href="{{ item.href }}">{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </div>

  <style>
    .site-nav{position:fixed;inset:0 0 auto 0;background:#fff;z-index:999;transition:box-shadow .18s ease,background .18s ease}
    .site-nav.scrolled{box-shadow:0 6px 18px rgba(21,21,21,.08)}
    .nav-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:.75rem 1rem}
    .logo{font-weight:700;text-decoration:none;color:inherit}
    .logo-mark{display:inline-block;padding:.25rem .5rem;border-radius:6px;background:#111;color:#fff;font-weight:700}
    .nav-links ul{list-style:none;margin:0;padding:0;display:flex;gap:1rem}
    .nav-links a{text-decoration:none;color:inherit;padding:.25rem .5rem}
    .hamburger{display:none;background:transparent;border:0;padding:.25rem;cursor:pointer}
    .hamburger .bar{display:block;width:22px;height:2px;background:#111;margin:4px 0;border-radius:2px}
    .mobile-menu{display:none;padding:1rem;background:#fff;border-top:1px solid rgba(0,0,0,.04)}
    .mobile-menu ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.5rem}
    .mobile-menu a{text-decoration:none;color:inherit;padding:.5rem 0;display:block}
    @media (max-width:768px){
      .nav-links{display:none}
      .hamburger{display:block}
      .mobile-menu{display:block}
      .mobile-menu[hidden]{display:none}
    }
  </style>

  <script>
    (function(){
      var nav = document.querySelector('.site-nav');
      var hamb = document.querySelector('.hamburger');
      var mobile = document.getElementById('mobile-menu');
      if(hamb && mobile){
        hamb.addEventListener('click', function(){
          var open = hamb.getAttribute('aria-expanded') === 'true';
          hamb.setAttribute('aria-expanded', String(!open));
          if(open){
            mobile.setAttribute('hidden', '');
            hamb.classList.remove('open');
          } else {
            mobile.removeAttribute('hidden');
            hamb.classList.add('open');
          }
        });
      }
      var last = 0;
      function onScroll(){
        var y = window.scrollY || window.pageYOffset;
        if(y > 10){
          nav.classList.add('scrolled');
        } else {
          nav.classList.remove('scrolled');
        }
        last = y;
      }
      window.addEventListener('scroll', onScroll, {passive:true});
      document.addEventListener('DOMContentLoaded', onScroll);
    })();
  </script>
</header>
