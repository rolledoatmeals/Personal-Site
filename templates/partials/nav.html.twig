  <header class="site-nav" role="banner">
    <div class="nav-inner">
      <a class="logo" href="/" aria-label="ZS home">
        <span class="logo-mark">ZS</span>
      </a>

      <nav class="nav-links" role="navigation" aria-label="Primary">
        <ul>
{% for item in nav %}
          <li>{% if item.href is defined %}<a href="{{ item.href }}">{{ item.label }}</a>{% else %}<a href="/#{{ item.scroll }}" data-scroll="{{ item.scroll }}">{{ item.label }}</a>{% endif %}</li>
{% endfor %}
        </ul>
      </nav>

      <button class="hamburger" aria-controls="mobile-menu" aria-expanded="false" aria-label="Toggle menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>

    <div id="mobile-menu" class="mobile-menu">
      <ul>
{% for item in nav %}
        <li>{% if item.href is defined %}<a href="{{ item.href }}">{{ item.label }}</a>{% else %}<a href="/#{{ item.scroll }}" data-scroll="{{ item.scroll }}">{{ item.label }}</a>{% endif %}</li>
{% endfor %}
      </ul>
    </div>
  </header>
