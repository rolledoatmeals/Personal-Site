  <rect width="24" height="24" rx="6" fill="url(#g-php)"/>
  <ellipse cx="12" cy="12" rx="7.5" ry="4.5" stroke="rgba(255,255,255,.25)" stroke-width="1" fill="none"/>
  <text x="50%" y="52%" text-anchor="middle" fill="#fff" font-size="8.5" font-family="Georgia, serif" dy=".35em" font-style="italic" font-weight="bold">php</text>
</svg>
{% elseif n == 'html' %}
