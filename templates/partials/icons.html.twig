{% macro skill_icon(name) %}
{% set n = name|lower %}
{% if n == 'php' %}
<svg class="skill-ico" width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#2D2D6B"/><text x="50%" y="52%" text-anchor="middle" fill="#fff" font-size="12" font-family="DM Sans, Arial" dy=".35em">PHP</text></svg>
{% elseif n == 'html' %}
<svg class="skill-ico" width="28" height="28" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#E44D26"/><path d="M7 7h10v2H7z" fill="#fff" opacity=".9"/></svg>
{% elseif n == 'css' %}
<svg class="skill-ico" width="28" height="28" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#264DE4"/><path d="M6 7h12v2H6z" fill="#fff" opacity=".9"/></svg>
{% elseif n == 'javascript' %}
<svg class="skill-ico" width="28" height="28" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#F0DB4F"/><text x="50%" y="52%" text-anchor="middle" fill="#333" font-size="12" font-family="DM Sans, Arial" dy=".35em">JS</text></svg>
{% elseif n == 'ai automation' %}
<svg class="skill-ico" width="28" height="28" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#7C3AED"/><path d="M8 12h8v2H8z" fill="#fff"/></svg>
{% elseif n == 'gohighlevel' or n == 'gohighlevel' %}
<svg class="skill-ico" width="28" height="28" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#00A3E0"/><path d="M6 8h12v2H6z" fill="#fff"/></svg>
{% elseif n == 'crm' %}
<svg class="skill-ico" width="28" height="28" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#FF7A18"/><circle cx="12" cy="12" r="3" fill="#fff"/></svg>
{% elseif n == 'webhooks' %}
<svg class="skill-ico" width="28" height="28" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#10B981"/><path d="M7 12h10v1H7z" fill="#fff"/></svg>
{% elseif n == 'vibe coding' %}
<svg class="skill-ico" width="28" height="28" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#FF5C99"/><circle cx="12" cy="12" r="4" fill="#fff" opacity=".12"/><path d="M9 12h6" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
{% else %}
<svg class="skill-ico" width="28" height="28" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect width="24" height="24" rx="6" fill="#666"/><path d="M12 7v8M8 11h8" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
{% endif %}
{% endmacro %}
