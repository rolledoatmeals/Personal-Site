{% macro skill_icon(name) %}
{% set n = name|lower %}
{% if n == 'php' %}
<svg class="skill-ico" width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
